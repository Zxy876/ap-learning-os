.DS_Store
__pycache__/
*.py[cod]

# Local runtime state and generated evidence
blackboard/*.md
data/*.json
data/**/*.json
data/**/*.sqlite3
data/**/*.db
data/online_platform/
logs/*.log
sessions/*
task_materials/*

# Keep directory placeholders
!blackboard/.gitkeep
!data/.gitkeep
!logs/.gitkeep
!sessions/.gitkeep
!task_materials/.gitkeep

# Do not commit generated/copyrighted study excerpts
*.pdf
*.png
