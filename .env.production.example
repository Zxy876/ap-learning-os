# AP Learning OS production environment template.
# Copy to .env.production on the server. Do not commit .env.production.

APLOS_HOST=0.0.0.0
APLOS_PORT=8776
APLOS_DB_PATH=/app/data/online_platform/aplos.sqlite3
APLOS_STORAGE_ROOT=/app/data/online_platform/storage

# Set these to enable role-token checks.
APLOS_AUTHOR_TOKEN=change-author-token
APLOS_EXECUTOR_TOKEN=change-executor-token
APLOS_REVIEWER_TOKEN=change-reviewer-token

# Optional S3-compatible storage such as Tencent COS through S3-compatible API,
# Cloudflare R2, AWS S3, or Supabase Storage.
# APLOS_S3_BUCKET=
# APLOS_S3_ENDPOINT_URL=
# APLOS_S3_REGION=
# APLOS_S3_ACCESS_KEY_ID=
# APLOS_S3_SECRET_ACCESS_KEY=
# APLOS_PUBLIC_BASE_URL=

# Optional Google Sheets writeback.
# APLOS_GOOGLE_SHEET_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-service-account.json
